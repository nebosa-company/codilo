{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codilo",
  "version": "0.4.7",
  "identifier": "com.codilo.editor",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Codilo",
        "width": 1200,
        "height": 800,
        "minWidth": 640,
        "minHeight": 400,
        "dragDropEnabled": false,
        "visible": false,
        "backgroundColor": "#1e1f26"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Codilo",
    "shortDescription": "A small, fast code editor",
    "fileAssociations": [
      {
        "ext": [
          "asm"
        ],
        "name": "Codilo.asm",
        "description": "Assembly source",
        "role": "Editor"
